{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bipbip",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "da41d51e-bb32-44a3-8a02-97c728c96bc7","database_name": "BIP" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "afa07da993c94a3ba2522332188a1df4" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
